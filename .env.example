DATABASE_HOST=localhost
DATABASE_USER=radius
DATABASE_PASSWORD=changeme
DATABASE_PORT=3306
DATABASE_NAME=radius

# 32-byte AES-256-GCM key, hex encoded (64 hex characters).
# Generate with: openssl rand -hex 32
# Keep this outside the database and out of version control.
ROUTER_ENCRYPTION_KEY=

# Optional: id of a row in tbl_routers used by the RouterOS integration tests.
ROUTER_TEST_ID=

# Temporary admin API bearer token for /api/routers endpoints.
# Send as: Authorization: Bearer <token>
# Use a long random value, e.g. openssl rand -hex 32. Never commit a real value.
ADMIN_API_TOKEN=

# Overall timeout (seconds) for live router status/resources requests.
ROUTER_API_TIMEOUT_SECS=15

# Shared secret FreeRADIUS (rlm_rest) uses for /internal/radius/* requests.
# Send as: Authorization: Bearer <token>
# Use a long random value, e.g. openssl rand -hex 32. Never commit a real value.
RADIUS_INTERNAL_TOKEN=

# --- Phase 2: background scheduler / sessions / disconnect ---
# Run the built-in background scheduler (expiry, renewals, disconnects, router
# health, NAS sync). Set false when running multiple API instances so only one
# worker schedules (jobs are still lease-protected either way).
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECS=15
SCHEDULER_LEASE_SECS=120
SCHEDULER_OWNER=
DISCONNECT_BATCH=50
ROUTER_STATUS_RETENTION_DAYS=30
ADMIN_RATE_LIMIT_PER_MIN=600

# CoA/Disconnect via radclient (freeradius-utils). Empty RADCLIENT_PATH disables
# the CoA method (RouterOS management fallback is still attempted).
RADCLIENT_PATH=radclient
# Optional global fallback CoA secret; per-router secrets are preferred (encrypted).
RADIUS_COA_SECRET=
