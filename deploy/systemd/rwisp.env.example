# RWISP environment template. Install to /etc/rwisp/rwisp.env (root:root, 0600).
# Never commit real secrets.

# --- Database (example shared with FreeRADIUS) ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=radius
DATABASE_PASSWORD=changeme
DATABASE_NAME=radius

# 32-byte AES-256-GCM key (64 hex chars): openssl rand -hex 32
ROUTER_ENCRYPTION_KEY=

# Admin API bearer token (bootstrap, role=admin): openssl rand -hex 32
ADMIN_API_TOKEN=
# FreeRADIUS internal endpoint token: openssl rand -hex 32
RADIUS_INTERNAL_TOKEN=

# --- Scheduler / sessions / disconnect ---
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECS=15
SCHEDULER_LEASE_SECS=120
SCHEDULER_OWNER=
DISCONNECT_BATCH=50
ROUTER_STATUS_RETENTION_DAYS=30
ADMIN_RATE_LIMIT_PER_MIN=600
RADCLIENT_PATH=radclient
RADIUS_COA_SECRET=
ROUTER_API_TIMEOUT_SECS=15
